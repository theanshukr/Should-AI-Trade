# ==============================================================================
# Should AI Trade? — Environment Variables Template
# Tagline: Every Trade Must Earn Its Yes.
# ==============================================================================
# IMPORTANT: Never commit actual API keys or secrets to source control.
# Copy this file to .env.local for local development.

# ------------------------------------------------------------------------------
# 1. Alpaca Paper Trading Credentials (Required for live paper broker integration)
# ------------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# ------------------------------------------------------------------------------
# 2. AI Model Providers (Optional: defaults to deterministic rule synthesis if omitted)
# ------------------------------------------------------------------------------
# Featherless AI endpoint configuration
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# OpenAI SDK compatible endpoint (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Security & Access Passphrase
# ------------------------------------------------------------------------------
# Demo/Operator dashboard passphrase (default: alpaca2026)
OPERATOR_PASSPHRASE=alpaca2026

# ------------------------------------------------------------------------------
# 4. Outbound Telemetry & Alert Webhooks (Optional)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=